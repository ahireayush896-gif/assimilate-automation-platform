# Application Settings
PROJECT_NAME="Assimilate Automation Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT
JWT_SECRET_KEY="change-me-to-a-super-secret-key-in-production-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Master Control-Plane Database (holds tenants, users, audit_auth_logs, invitations)
# Format: postgresql://<username>:<password>@<host>:<port>/<db_name>
MASTER_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/assimilate_master_db"

# Template Database Name (used to clone new tenant databases)
TENANT_TEMPLATE_DB_NAME="tenant_template_db"

# Base PostgreSQL connection string for dynamic tenant database routing
# Format: postgresql://<username>:<password>@<host>:<port>/
TENANT_DATABASE_BASE_URL="postgresql://postgres:postgres@localhost:5432/"

# GitHub App Integration Settings
GITHUB_APP_ID="123456"
GITHUB_APP_PRIVATE_KEY_PATH="private-key.pem"
GITHUB_WEBHOOK_SECRET="change-this-webhook-secret-min-32-chars"

# CORS Configuration (JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]
